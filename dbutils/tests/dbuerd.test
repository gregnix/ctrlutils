package require Tcl 8.6-
package require tcltest
namespace import ::tcltest::*

set root [file normalize [file join [file dirname [info script]] ..]]
catch {tcl::tm::path add [file join $root lib tm]}
if {[info exists ::env(DBUTILS_TM)]} { catch {tcl::tm::path add $::env(DBUTILS_TM)} }
package require dbutils::dbuerd

namespace eval M { namespace import ::dbutils::dbuerd::* }

# tuer round-trip only runs when tclutils is reachable
if {[info exists ::env(TCLUTILS_TM)]} { catch {tcl::tm::path add $::env(TCLUTILS_TM)} }
testConstraint haveTuer [expr {![catch {package require tclutils::tuer}]}]

set schema {
  tables {
    region   {cols {{id INTEGER 1 1 0} {name VARCHAR 1 0 0}}}
    customer {cols {{id INTEGER 1 1 0} {name VARCHAR 1 0 0} {region_id INTEGER 0 0 1}}}
    orders   {cols {{id INTEGER 1 1 0} {customer_id INTEGER 1 0 1}}}
  }
  fks {
    {customer region_id region id 0 0}
    {orders customer_id customer id 1 0}
  }
}

# --- generation --------------------------------------------------------------

test dbuerd-1.1 {output starts with the erDiagram header} -body {
    string match "erDiagram\n*" [M::generate $::schema]
} -result 1

test dbuerd-1.2 {each table becomes an entity block} -body {
    set out [M::generate $::schema]
    list [string match "*region \{*" $out] [string match "*customer \{*" $out] \
         [string match "*orders \{*" $out]
} -result {1 1 1}

test dbuerd-1.3 {a column renders type, name and PK/FK key} -body {
    set out [M::generate $::schema]
    list [string match "*INTEGER id PK*" $out] [string match "*INTEGER region_id FK*" $out]
} -result {1 1}

test dbuerd-1.4 {NOT NULL fk -> parent exactly-one (||); nullable -> zero-or-one (o|)} -body {
    set out [M::generate $::schema]
    list [string match "*orders \}o..|| customer : customer_id*" $out] \
         [string match "*customer \}o..o| region : region_id*" $out]
} -result {1 1}

test dbuerd-1.5 {identifying fk is solid (--), non-identifying is dashed (..)} -body {
    set s {tables {a {cols {{id INTEGER 1 1 0}}} b {cols {{a_id INTEGER 1 1 1}}}}
           fks {{b a_id a id 1 1}}}
    string match "*b \}o--|| a : a_id*" [M::generate $s]
} -result 1

test dbuerd-1.6 {catalogue names are normalised to tuer-safe ids} -body {
    set s {tables {{my.schema.tbl} {cols {{id INTEGER 1 1 0}}}} fks {}}
    string match "*my_schema_tbl \{*" [M::generate $s]
} -result 1

# --- errors ------------------------------------------------------------------

test dbuerd-2.1 {a schema with no tables raises DBUERD EMPTY} -body {
    catch {M::generate {tables {} fks {}}} e o
    lindex [dict get $o -errorcode] 2
} -result EMPTY

test dbuerd-2.2 {a malformed fk entry raises DBUERD ARG} -body {
    catch {M::generate {tables {a {cols {}}} fks {{a x}}}} e o
    lindex [dict get $o -errorcode] 2
} -result ARG

# --- round-trip through tclutils::tuer (only if tclutils is reachable) -------

test dbuerd-3.1 {generated markup parses cleanly into a tuer model} -constraints haveTuer -body {
    set m [::tclutils::tuer::parse [M::generate $::schema]]
    list [llength [dict get $m nodes]] [llength [dict get $m edges]]
} -result {3 2}

cleanupTests
