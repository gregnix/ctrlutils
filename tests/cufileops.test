package require tcltest
namespace import ::tcltest::*

set here [file dirname [file normalize [info script]]]
set root [file dirname $here]
tcl::tm::path add [file join $root lib tm]
tcl::tm::path add [file join $root .. tclutils lib tm]
tcl::tm::path add [file join $root .. tkutils lib tm]

# cufileops is GUI code (it uses a context menu and dialogs), so it can only be
# loaded when Tk is present. Gate the load behind the Tk constraint so a
# headless "tclsh some.test" run skips these tests cleanly instead of erroring
# out at load time.
set tkPresent [expr {![catch {package require Tk}]}]
set loadErr ""
if {$tkPresent
 && ![catch {package require ctrlutils::cufileops} loadErr]
 && ![catch {package require tkutils::tkufilelist} loadErr]} {
    testConstraint haveTk 1
    set loadErr ""
} else {
    testConstraint haveTk 0
}
# Tk is there but the modules did not load: a failure, not a skip.
testConstraint tkPresent $tkPresent
test cufileops-0.0 {the modules load when Tk is available} -constraints tkPresent -body {
    set ::loadErr
} -result {}
package require tclutils::tuprovider

# A tiny read-only in-memory provider, defined inline so the cross-provider
# tests do not depend on the ZIP provider (or any other) being installed.
# cufileops only calls methods on the provider object, so this is enough to
# stand in as a "different provider" source: get for a file, list for a dir.
# (An earlier version required the zip provider and swallowed the load failure
# with catch -- which passed locally but failed on a clean checkout with
# "unknown scheme 'zip'". This inline provider removes that dependency.)
oo::class create MemSource {
    variable Files
    constructor {files} { set Files $files }
    method caps {} { return {list stat get} }
    method get {path} {
        if {![dict exists $Files $path]} { error "no such file: $path" }
        return [dict get $Files $path]
    }
    method stat {path} {
        if {![dict exists $Files $path]} { error "no such file: $path" }
        return [dict create name [file tail $path] path $path type file \
                    size [string length [dict get $Files $path]]]
    }
    method list {dir} {
        set out {}
        dict for {p c} $Files {
            lappend out [dict create name [file tail $p] path $p type file \
                             size [string length $c]]
        }
        return $out
    }
}

set ::tgt [makeDirectory cufops]

test cufileops-2.1 {install wires the list without error} -constraints haveTk -setup {
    set prov [::tclutils::tuprovider open local]
    ::tkutils::tkufilelist::widget .fl -provider $prov -dir $::tgt
} -body {
    ::ctrlutils::cufileops::install tabA $prov .fl {}
    expr {[bind .fl.tbl.body <Button-3>] ne "" \
       && [bind .fl.tbl.body <Delete>]  ne ""}
} -cleanup {
    destroy .fl
} -result 1

test cufileops-2.2 {cross-provider copy: in-memory source to local target} -constraints haveTk -setup {
    set src [MemSource new {/doc.txt {content from the source}}]
    set lp  [::tclutils::tuprovider open local]
    ::tkutils::tkufilelist::widget .zl -provider $src -dir /
    ::tkutils::tkufilelist::widget .ll -provider $lp  -dir $::tgt
    ::ctrlutils::cufileops::install zTab $src .zl {}
    ::ctrlutils::cufileops::install lTab $lp  .ll {}
} -body {
    ::ctrlutils::cufileops::copy zTab \
        [dict create name doc.txt path /doc.txt type file size 22]
    ::ctrlutils::cufileops::paste lTab
    set out [glob -nocomplain -tails -directory $::tgt *]
    set fh [open [file join $::tgt doc.txt]] ; set data [read $fh] ; close $fh
    list [lsearch -inline $out doc.txt] [string trim $data]
} -cleanup {
    destroy .zl .ll
    $src destroy
    catch {file delete [file join $::tgt doc.txt]}
} -result {doc.txt {content from the source}}

test cufileops-2.3 {paste collision picks a (copy) name} -constraints haveTk -setup {
    set fh [open [file join $::tgt doc.txt] w] ; puts $fh existing ; close $fh
    set src [MemSource new {/doc.txt {content from the source}}]
    set lp  [::tclutils::tuprovider open local]
    ::tkutils::tkufilelist::widget .zl2 -provider $src -dir /
    ::tkutils::tkufilelist::widget .ll2 -provider $lp  -dir $::tgt
    ::ctrlutils::cufileops::install zT2 $src .zl2 {}
    ::ctrlutils::cufileops::install lT2 $lp  .ll2 {}
} -body {
    ::ctrlutils::cufileops::copy zT2 \
        [dict create name doc.txt path /doc.txt type file size 22]
    ::ctrlutils::cufileops::paste lT2
    expr {[file exists [file join $::tgt doc.txt]]
       && [file exists [file join $::tgt {doc (copy).txt}]]}
} -cleanup {
    destroy .zl2 .ll2
    $src destroy
    catch {file delete [file join $::tgt doc.txt]}
    catch {file delete [file join $::tgt {doc (copy).txt}]}
} -result 1

# showError waits; tests that refuse a cap stub _dlg so they do not hang.
proc stubDlg {} {
    set ::dlgCalls {}
    rename ::ctrlutils::cufileops::_dlg ::ctrlutils::cufileops::_dlgSaved
    proc ::ctrlutils::cufileops::_dlg {f cmd args} {
        lappend ::dlgCalls [list $cmd {*}$args]
        return
    }
}
proc unstubDlg {} {
    catch {rename ::ctrlutils::cufileops::_dlg {}}
    catch {rename ::ctrlutils::cufileops::_dlgSaved ::ctrlutils::cufileops::_dlg}
}

test cufileops-2.4 {cut is refused on a read-only source (no delete cap)} -constraints haveTk -setup {
    set src [MemSource new {/doc.txt {x}}]
    ::tkutils::tkufilelist::widget .cz -provider $src -dir /
    ::ctrlutils::cufileops::install czTab $src .cz {}
    set ::ctrlutils::cufileops::clip {}
    stubDlg
} -body {
    ::ctrlutils::cufileops::cut czTab \
        [dict create name doc.txt path /doc.txt type file size 1]
    list [::ctrlutils::cufileops::_haveClip] $::dlgCalls
} -cleanup {
    unstubDlg
    destroy .cz ; $src destroy ; set ::ctrlutils::cufileops::clip {}
} -result {0 {{showError {Cut is not available here (the source cannot delete).}}}}

test cufileops-2.10 {Delete key says so when the source cannot delete} -constraints haveTk -setup {
    set src [MemSource new {/doc.txt {x}}]
    ::tkutils::tkufilelist::widget .kd -provider $src -dir /
    ::ctrlutils::cufileops::install kdTab $src .kd {}
    stubDlg
} -body {
    ::ctrlutils::cufileops::_keyDelete kdTab
    set ::dlgCalls
} -cleanup {
    unstubDlg
    destroy .kd ; $src destroy
} -result {{showError {Delete is not available here (the source cannot delete).}}}

test cufileops-2.11 {Ctrl+X says so when the source cannot delete} -constraints haveTk -setup {
    set src [MemSource new {/doc.txt {x}}]
    ::tkutils::tkufilelist::widget .kx -provider $src -dir /
    ::ctrlutils::cufileops::install kxTab $src .kx {}
    stubDlg
} -body {
    ::ctrlutils::cufileops::_keyCut kxTab
    set ::dlgCalls
} -cleanup {
    unstubDlg
    destroy .kx ; $src destroy
} -result {{showError {Cut is not available here (the source cannot delete).}}}

test cufileops-2.5 {cross-provider cut moves the file and removes the source} -constraints haveTk -setup {
    set srcdir [file join $::tgt cutsrc] ; file mkdir $srcdir
    set fh [open [file join $srcdir m.txt] w] ; puts -nonewline $fh "move me" ; close $fh
    set sp [::tclutils::tuprovider open local]
    set dp [::tclutils::tuprovider open local]
    ::tkutils::tkufilelist::widget .cs -provider $sp -dir $srcdir
    ::tkutils::tkufilelist::widget .cd -provider $dp -dir $::tgt
    ::ctrlutils::cufileops::install csT $sp .cs {}
    ::ctrlutils::cufileops::install cdT $dp .cd {}
    set ::ctrlutils::cufileops::clip {}
} -body {
    ::ctrlutils::cufileops::cut csT \
        [dict create name m.txt path [file join $srcdir m.txt] type file size 7]
    ::ctrlutils::cufileops::paste cdT
    list [file exists [file join $::tgt m.txt]] \
         [file exists [file join $srcdir m.txt]]
} -cleanup {
    destroy .cs .cd
    catch {file delete [file join $::tgt m.txt]}
    catch {file delete -force [file join $::tgt cutsrc]}
    set ::ctrlutils::cufileops::clip {}
} -result {1 0}


test cufileops-2.6 {_localPath returns a local file path as-is} -constraints haveTk -setup {
    set d [makeDirectory ow]
    set fh [open [file join $d a.txt] w] ; puts -nonewline $fh hi ; close $fh
    set lp [::tclutils::tuprovider open local]
    namespace eval ::ctrlutils::cufileops { variable state }
    set ::ctrlutils::cufileops::state(loc,prov) $lp
} -body {
    set entry [dict create name a.txt path [file join $d a.txt] type file size 2]
    set got [::ctrlutils::cufileops::_localPath loc $entry]
    string equal $got [file join $d a.txt]
} -cleanup {
    catch {file delete [file join $d a.txt]}
} -result 1

test cufileops-2.7 {_localPath materializes provider bytes under the process dir} -constraints haveTk -setup {
    proc ::testprov {method args} { if {$method eq "get"} { return "BYTES" } }
    namespace eval ::ctrlutils::cufileops { variable state }
    set ::ctrlutils::cufileops::state(tt,prov) ::testprov
} -body {
    set entry [dict create name doc.pdf path /in/zip/doc.pdf type file size 5]
    set lp [::ctrlutils::cufileops::_localPath tt $entry]
    set ch [open $lp rb] ; set got [read $ch] ; close $ch
    list [string match */cufileops-[pid]-* $lp] \
         [string match *.pdf $lp] $got
} -cleanup {
    catch {file delete $lp}
    rename ::testprov ""
} -result {1 1 BYTES}

test cufileops-2.8 {_localPath does not open a colliding local file for a non-local provider} -constraints haveTk -setup {
    set ::collide [file join $::tgt collide.txt]
    set fh [open $::collide w] ; puts -nonewline $fh LOCAL ; close $fh
    proc ::zipish {method args} {
        if {$method eq "get"} { return "ZIPBYTES" }
    }
    namespace eval ::ctrlutils::cufileops { variable state }
    set ::ctrlutils::cufileops::state(zp,prov) ::zipish
} -body {
    set entry [dict create name collide.txt path $::collide type file size 8]
    set lp [::ctrlutils::cufileops::_localPath zp $entry]
    set ch [open $lp rb] ; set got [read $ch] ; close $ch
    set fh [open $::collide r] ; set still [read $fh] ; close $fh
    list [string equal $lp $::collide] $got $still
} -cleanup {
    catch {file delete $lp}
    catch {file delete $::collide}
    rename ::zipish ""
} -result {0 ZIPBYTES LOCAL}

test cufileops-2.9 {_copyTree rolls back a half-copied folder} -constraints haveTk -setup {
    oo::class create FailSrc {
        superclass ::tclutils::tuprovider::Base
        method list {dir} {
            if {$dir eq "/d"} {
                return [list \
                    [dict create name a.txt path /d/a.txt type file] \
                    [dict create name b.txt path /d/b.txt type file]]
            }
            return [list [dict create name d path /d type dir]]
        }
        method get {path} {
            if {$path eq "/d/b.txt"} { error "boom" }
            return OK
        }
        method stat {path} { return [dict create name [file tail $path] path $path type file] }
    }
    set ::fsrc [FailSrc new]
    set ::flp [::tclutils::tuprovider open local]
    set ::destdir [file join $::tgt rolled]
} -body {
    set rc [catch {::ctrlutils::cufileops::_copyTree $::fsrc /d $::flp $::destdir} e]
    list $rc [file exists $::destdir] [file exists [file join $::destdir a.txt]]
} -cleanup {
    catch {$::fsrc destroy}
    catch {file delete -force $::destdir}
} -result {1 0 0}


test cufileops-3.1 {open-with registry: add apps and read them back} -constraints haveTk -setup {
    set ::ctrlutils::cufileops::owFile [file join [tcltest::temporaryDirectory] ow1.dict]
    catch {file delete $::ctrlutils::cufileops::owFile}
    set ::ctrlutils::cufileops::owLoaded 0 ; set ::ctrlutils::cufileops::owCache ""
} -body {
    ::ctrlutils::cufileops::owAddApp .txt gedit
    ::ctrlutils::cufileops::owAddApp .txt {code -w}
    ::ctrlutils::cufileops::owAddApp .txt gedit ;# duplicate ignored
    ::ctrlutils::cufileops::owApps .txt
} -cleanup {
    catch {file delete $::ctrlutils::cufileops::owFile}
    set ::ctrlutils::cufileops::owFile ""
} -result {gedit {code -w}}

test cufileops-3.2 {open-with registry: default set, persisted across reload} -constraints haveTk -setup {
    set ::ctrlutils::cufileops::owFile [file join [tcltest::temporaryDirectory] ow2.dict]
    catch {file delete $::ctrlutils::cufileops::owFile}
    set ::ctrlutils::cufileops::owLoaded 0 ; set ::ctrlutils::cufileops::owCache ""
} -body {
    ::ctrlutils::cufileops::owAddApp .pdf evince
    ::ctrlutils::cufileops::owSetDefault .pdf okular ;# adds + defaults
    # force a reload from disk
    set ::ctrlutils::cufileops::owLoaded 0 ; set ::ctrlutils::cufileops::owCache ""
    list [lsort [::ctrlutils::cufileops::owApps .pdf]] [::ctrlutils::cufileops::owDefault .pdf]
} -cleanup {
    catch {file delete $::ctrlutils::cufileops::owFile}
    set ::ctrlutils::cufileops::owFile ""
} -result {{evince okular} okular}

test cufileops-3.3 {open-with registry: removing the default clears it} -constraints haveTk -setup {
    set ::ctrlutils::cufileops::owFile [file join [tcltest::temporaryDirectory] ow3.dict]
    catch {file delete $::ctrlutils::cufileops::owFile}
    set ::ctrlutils::cufileops::owLoaded 0 ; set ::ctrlutils::cufileops::owCache ""
} -body {
    ::ctrlutils::cufileops::owSetDefault .md {code -w}
    ::ctrlutils::cufileops::owRemoveApp .md {code -w}
    list [::ctrlutils::cufileops::owApps .md] [::ctrlutils::cufileops::owDefault .md]
} -cleanup {
    catch {file delete $::ctrlutils::cufileops::owFile}
    set ::ctrlutils::cufileops::owFile ""
} -result {{} {}}

test cufileops-3.4 {open-with key derivation is case-insensitive, keeps the dot} -constraints haveTk -body {
    list [::ctrlutils::cufileops::_owKey photo.JPG] \
         [::ctrlutils::cufileops::_owKey NOTES.txt] \
         [::ctrlutils::cufileops::_owKey README]
} -result {.jpg .txt {}}


test cufileops-3.5 {suggestion categories map extensions correctly} -constraints haveTk -body {
    list [::ctrlutils::cufileops::_owCats .tcl] \
         [::ctrlutils::cufileops::_owCats .tm] \
         [::ctrlutils::cufileops::_owCats .png] \
         [::ctrlutils::cufileops::_owCats .pdf] \
         [::ctrlutils::cufileops::_owCats .html] \
         [::ctrlutils::cufileops::_owCats .txt] \
         [::ctrlutils::cufileops::_owCats .xyz]
} -result {{tcleditor editor} {tcleditor editor} {image editor} pdf {html editor} editor editor}

test cufileops-3.6 {suggestions list only installed apps and exclude registered} -constraints haveTk -setup {
    set ::ctrlutils::cufileops::owFile [file join [tcltest::temporaryDirectory] ow6.dict]
    catch {file delete $::ctrlutils::cufileops::owFile}
    set ::ctrlutils::cufileops::owLoaded 0 ; set ::ctrlutils::cufileops::owCache ""
    # a fake app guaranteed NOT installed must never be suggested
} -body {
    set sug [::ctrlutils::cufileops::_owSuggest .txt]
    # every suggested command's executable must be resolvable on PATH
    set allInstalled 1
    foreach cmd $sug {
        if {[auto_execok [lindex $cmd 0]] eq ""} { set allInstalled 0 }
    }
    # registering one of the suggestions removes it from later suggestions
    set excluded 1
    if {[llength $sug]} {
        set one [lindex $sug 0]
        ::ctrlutils::cufileops::owAddApp .txt $one
        if {$one in [::ctrlutils::cufileops::_owSuggest .txt]} { set excluded 0 }
    }
    list $allInstalled $excluded
} -cleanup {
    catch {file delete $::ctrlutils::cufileops::owFile}
    set ::ctrlutils::cufileops::owFile ""
} -result {1 1}


test cufileops-3.7 {a Tcl editor on PATH is suggested first for .tcl} -constraints haveTk -setup {
    set ::ctrlutils::cufileops::owFile [file join [tcltest::temporaryDirectory] ow7.dict]
    catch {file delete $::ctrlutils::cufileops::owFile}
    set ::ctrlutils::cufileops::owLoaded 0 ; set ::ctrlutils::cufileops::owCache ""
    # create a fake "alited" on PATH so detection finds it, regardless of host
    set bindir [file join [tcltest::temporaryDirectory] owbin7]
    file mkdir $bindir
    if {$::tcl_platform(platform) eq "windows"} {
        # auto_execok finds programs through PATHEXT there
        set exe [file join $bindir alited.bat]
        set ch [open $exe w] ; puts $ch "@echo alited" ; close $ch
        set sep ";"
    } else {
        set exe [file join $bindir alited]
        set ch [open $exe w] ; puts $ch "#!/bin/sh\necho alited" ; close $ch
        catch {file attributes $exe -permissions 0755}
        set sep ":"
    }
    set ::savedPath $::env(PATH)
    set ::env(PATH) "[file nativename $bindir]$sep$::env(PATH)"
    # Clear only the auto_execok cache. Up to ctrlutils 0.1 this called
    # auto_reset, which also deletes every auto-loaded proc -- Tablelist's
    # among them; the next tablelist widget in this interpreter then failed
    # with 'can't set "scalingpct": the variable is read-only'.
    array unset ::auto_execs
} -body {
    set sug [::ctrlutils::cufileops::_owSuggest .tcl]
    # alited (from the tcleditor category) must be present and come first
    lindex $sug 0
} -cleanup {
    catch {file delete $::ctrlutils::cufileops::owFile}
    set ::ctrlutils::cufileops::owFile ""
    catch {file delete -force [file join [tcltest::temporaryDirectory] owbin7]}
    set ::env(PATH) $::savedPath
    array unset ::auto_execs
} -result alited

# --- 0.2: dialogs open over the view's own window ---------------------------
# Up to 0.1 no tkudialog call got -parent, and every prompt/error/confirmation
# opened in the middle of the screen -- on a second monitor, the wrong one.
proc findDialog {} {
    foreach w [winfo children .] {
        if {[string match .tkudialog* $w] && [winfo exists $w]} { return $w }
    }
    return ""
}

test cufileops-9.1 {newFolder prompts over the Explorer window, transient to it} -constraints haveTk -setup {
    catch {destroy .ex}
    toplevel .ex
    wm geometry .ex 400x300+860+560
    set prov [::tclutils::tuprovider open local]
    ::tkutils::tkufilelist::widget .ex.fl -provider $prov -dir $::tgt
    pack .ex.fl -fill both -expand 1
    ::ctrlutils::cufileops::install tabP $prov .ex.fl {}
    update
} -body {
    set ::meas {}
    # The Explorer window is measured where it really is, at the same moment
    # as the dialog: under a decorating window manager its content does not
    # sit at the requested +860+560 (openbox: +1+20).
    after 300 {
        set d [findDialog]
        set ::meas [list [expr {[winfo rootx $d] + [winfo width $d] / 2}] \
                         [expr {[winfo rooty $d] + [winfo height $d] / 2}] \
                         [expr {[winfo rootx .ex] + [winfo width .ex] / 2}] \
                         [expr {[winfo rooty .ex] + [winfo height .ex] / 2}] \
                         [wm transient $d]]
        ::tkutils::tkudialog::choose $d Cancel
    }
    ::ctrlutils::cufileops::newFolder tabP
    lassign $::meas cx cy ex ey tr
    list [expr {abs($cx - $ex) <= 2}] [expr {abs($cy - $ey) <= 2}] $tr
} -cleanup {
    destroy .ex
} -result {1 1 .ex}

test cufileops-9.2 {_dlgParent is the toplevel of the view's list} -constraints haveTk -setup {
    catch {destroy .ex2}
    toplevel .ex2
    set prov [::tclutils::tuprovider open local]
    ::tkutils::tkufilelist::widget .ex2.fl -provider $prov -dir $::tgt
    ::ctrlutils::cufileops::install tabQ $prov .ex2.fl {}
} -body {
    list [::ctrlutils::cufileops::_dlgParent tabQ] [::ctrlutils::cufileops::_dlgParent unknownTab]
} -cleanup { destroy .ex2 } -result {.ex2 {}}

test cufileops-9.3 {install: unknown option is an error that names the known ones} -constraints haveTk -body {
    set prov [::tclutils::tuprovider open local]
    catch {::ctrlutils::cufileops::install tabR $prov .nolist {} -onpo x} m o
    list [dict get $o -errorcode] [string match "*Known: -onop" $m]
} -result {{CTRLUTILS CUFILEOPS OPTION -onpo} 1}

