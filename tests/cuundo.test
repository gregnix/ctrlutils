package require tcltest
namespace import ::tcltest::*

set here [file dirname [file normalize [info script]]]
set root [file dirname $here]
tcl::tm::path add [file join $root lib tm]
tcl::tm::path add [file join $root .. tclutils lib tm]

package require ctrlutils::cuundo
package require tclutils::tuprovider

# Undo/redo can be exercised headlessly: cuundo reverses through the provider,
# no widgets needed. We drive cufileops' operation records directly via the
# -onop path by calling cuundo::record, and check the filesystem effect.

set dir [makeDirectory undo]
proc prov {} { ::tclutils::tuprovider open local }
proc exists {p} { file exists $p }

test cuundo-1.1 {undo of mkdir removes the directory} -setup {
    set p [prov]
    ::ctrlutils::cuundo::install t1 $p
} -body {
    set d [file join $::dir made]
    $p mkdir $d
    ::ctrlutils::cuundo::record t1 [dict create op mkdir path $d]
    set before [exists $d]
    ::ctrlutils::cuundo::undo t1
    list $before [exists $d]
} -cleanup {
    ::ctrlutils::cuundo::clear t1
    catch {file delete -force [file join $::dir made]}
} -result {1 0}

test cuundo-1.2 {redo of mkdir re-creates it} -setup {
    set p [prov]
    ::ctrlutils::cuundo::install t2 $p
} -body {
    set d [file join $::dir made2]
    $p mkdir $d
    ::ctrlutils::cuundo::record t2 [dict create op mkdir path $d]
    ::ctrlutils::cuundo::undo t2
    ::ctrlutils::cuundo::redo t2
    exists $d
} -cleanup {
    ::ctrlutils::cuundo::clear t2
    catch {file delete -force [file join $::dir made2]}
} -result 1

test cuundo-1.3 {undo of rename moves it back} -setup {
    set p [prov]
    ::ctrlutils::cuundo::install t3 $p
    set fh [open [file join $::dir a.txt] w] ; puts $fh hi ; close $fh
} -body {
    set from [file join $::dir a.txt]
    set to   [file join $::dir b.txt]
    $p move $from $to
    ::ctrlutils::cuundo::record t3 [dict create op rename from $from to $to type file]
    set afterMove [list [exists $from] [exists $to]]
    ::ctrlutils::cuundo::undo t3
    concat $afterMove [list [exists $from] [exists $to]]
} -cleanup {
    ::ctrlutils::cuundo::clear t3
    catch {file delete [file join $::dir a.txt] [file join $::dir b.txt]}
} -result {0 1 1 0}

test cuundo-1.4 {undo of delete restores a file with its content} -setup {
    set p [prov]
    ::ctrlutils::cuundo::install t4 $p
    set fh [open [file join $::dir doc.txt] w] ; puts -nonewline $fh "important" ; close $fh
} -body {
    set path [file join $::dir doc.txt]
    # snapshot before delete (as cufileops::delete does), then delete
    set snap [::ctrlutils::cuundo::_snapshot $p $path file]
    $p delete $path
    ::ctrlutils::cuundo::record t4 [dict create op delete path $path type file saved $snap]
    set gone [exists $path]
    ::ctrlutils::cuundo::undo t4
    set back [exists $path]
    set fh [open $path] ; set content [read $fh] ; close $fh
    list $gone $back $content
} -cleanup {
    ::ctrlutils::cuundo::clear t4
    catch {file delete [file join $::dir doc.txt]}
} -result {0 1 important}

test cuundo-1.5 {undo of delete restores a whole directory tree} -setup {
    set p [prov]
    ::ctrlutils::cuundo::install t5 $p
    set d [file join $::dir tree]
    file mkdir [file join $d sub]
    set fh [open [file join $d top.txt] w] ; puts -nonewline $fh T ; close $fh
    set fh [open [file join $d sub inner.txt] w] ; puts -nonewline $fh I ; close $fh
} -body {
    set d [file join $::dir tree]
    set snap [::ctrlutils::cuundo::_snapshot $p $d dir]
    $p delete $d
    ::ctrlutils::cuundo::record t5 [dict create op delete path $d type dir saved $snap]
    ::ctrlutils::cuundo::undo t5
    list [exists [file join $d top.txt]] [exists [file join $d sub inner.txt]]
} -cleanup {
    ::ctrlutils::cuundo::clear t5
    catch {file delete -force [file join $::dir tree]}
} -result {1 1}

test cuundo-1.6 {new activity clears the redo stack} -setup {
    set p [prov]
    ::ctrlutils::cuundo::install t6 $p
} -body {
    set d [file join $::dir x]
    $p mkdir $d
    ::ctrlutils::cuundo::record t6 [dict create op mkdir path $d]
    ::ctrlutils::cuundo::undo t6                 ;# redo now available
    set r1 [::ctrlutils::cuundo::canRedo t6]
    ::ctrlutils::cuundo::record t6 [dict create op mkdir path [file join $::dir y]]
    set r2 [::ctrlutils::cuundo::canRedo t6]     ;# cleared by new record
    list $r1 $r2
} -cleanup {
    ::ctrlutils::cuundo::clear t6
    catch {file delete -force [file join $::dir x] [file join $::dir y]}
} -result {1 0}

test cuundo-1.7 {undo on an empty stack is a no-op} -setup {
    set p [prov]
    ::ctrlutils::cuundo::install t7 $p
} -body {
    ::ctrlutils::cuundo::undo t7
    ::ctrlutils::cuundo::canUndo t7
} -cleanup {
    ::ctrlutils::cuundo::clear t7
} -result 0

test cuundo-1.8 {undo of a cross-provider move restores source, removes target} -setup {
    set sp [prov] ; set dp [prov]
    ::ctrlutils::cuundo::install t8 $dp
} -body {
    # simulate the state after a cut+paste move: content at the target, gone at
    # the source. The record carries both providers and the source snapshot.
    set from [file join $::dir mv_src.txt]
    set to   [file join $::dir mv_dst.txt]
    $dp put $to "moved content"
    set snap [dict create type file bytes "moved content"]
    ::ctrlutils::cuundo::record t8 [dict create op movex \
        srcprov $sp dstprov $dp from $from to $to type file saved $snap]
    ::ctrlutils::cuundo::undo t8
    set srcBack [expr {[exists $from] && [string trim [$sp get $from]] eq "moved content"}]
    set dstGone [expr {![exists $to]}]
    list $srcBack $dstGone
} -cleanup {
    ::ctrlutils::cuundo::clear t8
    catch {file delete [file join $::dir mv_src.txt] [file join $::dir mv_dst.txt]}
} -result {1 1}

test cuundo-1.9 {redo of a cross-provider move re-applies it} -setup {
    set sp [prov] ; set dp [prov]
    ::ctrlutils::cuundo::install t9 $dp
} -body {
    set from [file join $::dir mv2_src.txt]
    set to   [file join $::dir mv2_dst.txt]
    $dp put $to "content two"
    set snap [dict create type file bytes "content two"]
    ::ctrlutils::cuundo::record t9 [dict create op movex \
        srcprov $sp dstprov $dp from $from to $to type file saved $snap]
    ::ctrlutils::cuundo::undo t9
    ::ctrlutils::cuundo::redo t9
    list [exists $to] [exists $from]
} -cleanup {
    ::ctrlutils::cuundo::clear t9
    catch {file delete [file join $::dir mv2_src.txt] [file join $::dir mv2_dst.txt]}
} -result {1 0}

test cuundo-1.10 {a failed redo keeps the step on the redo stack} -setup {
    set p [prov]
    ::ctrlutils::cuundo::install t10 $p
    set fh [open [file join $::dir c.txt] w] ; puts $fh hi ; close $fh
} -body {
    set from [file join $::dir c.txt]
    set to   [file join $::dir d.txt]
    $p move $from $to
    ::ctrlutils::cuundo::record t10 [dict create op rename from $from to $to type file]
    ::ctrlutils::cuundo::undo t10                 ;# d.txt -> c.txt
    file delete $from                             ;# redo has nothing to move
    ::ctrlutils::cuundo::redo t10                 ;# fails
    ::ctrlutils::cuundo::canRedo t10
} -cleanup {
    ::ctrlutils::cuundo::clear t10
    catch {file delete [file join $::dir c.txt] [file join $::dir d.txt]}
} -result 1

test cuundo-9.1 {install: unknown option is an error that names the known ones} -body {
    set p [::tclutils::tuprovider open local]
    catch {::ctrlutils::cuundo::install t9 $p -lst .x} m o
    list [dict get $o -errorcode] [string match "*Known: -list, -refresh" $m]
} -result {{CTRLUTILS CUUNDO OPTION -lst} 1}

test cuundo-10.1 {texts go through msgcat with %s arguments} -setup {
    package require msgcat
    namespace eval ::ctrlutils { ::msgcat::mcset {} "Undo failed:\n%s" "Rueckgaengig fehlgeschlagen:\n%s" }
} -body {
    ::ctrlutils::cuundo::_ "Undo failed:\n%s" x
} -cleanup {
    namespace eval ::ctrlutils { ::msgcat::mcset {} "Undo failed:\n%s" "Undo failed:\n%s" }
} -result "Rueckgaengig fehlgeschlagen:\nx"

testConstraint haveTk [expr {![catch {package require Tk}]}]

test cuundo-11.1 {failed undo: dialog gets -parent and a msgcat text} -constraints haveTk -setup {
    wm withdraw .
    frame .uw ; frame .uw.tbl ; frame .uw.tbl.body
    namespace eval ::tkutils::tkudialog {}
    set ::dlgArgs {}
    proc ::tkutils::tkudialog::showError {args} { set ::dlgArgs $args }
    namespace eval ::ctrlutils {
        ::msgcat::mcset [::msgcat::mclocale] "no saved content to restore" "nichts gesichert"
    }
    set p [prov]
    ::ctrlutils::cuundo::install t11 $p -list .uw
} -body {
    ::ctrlutils::cuundo::record t11 [dict create op delete path /nirgends type file saved ""]
    ::ctrlutils::cuundo::undo t11
    list [string match "*nichts gesichert*" [lindex $::dlgArgs 0]] \
         [lrange $::dlgArgs 1 end]
} -cleanup {
    ::ctrlutils::cuundo::clear t11
    rename ::tkutils::tkudialog::showError {}
    destroy .uw
} -result {1 {-parent .}}

test cuundo-12.1 {-refresh runs after undo and redo (0.5)} -setup {
    set p [prov]
    set ::refN 0
    ::ctrlutils::cuundo::install t12 $p -refresh {incr ::refN}
} -body {
    set d [file join $::dir made12]
    $p mkdir $d
    ::ctrlutils::cuundo::record t12 [dict create op mkdir path $d]
    ::ctrlutils::cuundo::undo t12
    ::ctrlutils::cuundo::redo t12
    set ::refN
} -cleanup {
    ::ctrlutils::cuundo::clear t12
    catch {file delete -force [file join $::dir made12]}
} -result 2

test cuundo-12.2 {a failing refresh is an error; the undo itself is done (0.5)} -setup {
    set p [prov]
    ::ctrlutils::cuundo::install t13 $p -refresh {error "list gone"}
} -body {
    set d [file join $::dir made13]
    $p mkdir $d
    ::ctrlutils::cuundo::record t13 [dict create op mkdir path $d]
    set rc [catch {::ctrlutils::cuundo::undo t13} m o]
    list $rc [dict get $o -errorcode] [exists $d] [::ctrlutils::cuundo::canRedo t13]
} -cleanup {
    ::ctrlutils::cuundo::clear t13
    catch {file delete -force [file join $::dir made13]}
} -result {1 {CTRLUTILS CUUNDO REFRESH} 0 1}

cleanupTests
