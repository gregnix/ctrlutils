package require tcltest
namespace import ::tcltest::*

set here [file dirname [file normalize [info script]]]
set root [file dirname $here]
tcl::tm::path add [file join $root lib tm]
tcl::tm::path add [file join $root .. tclutils lib tm]
tcl::tm::path add [file join $root .. tkutils lib tm]

# Tk is needed for the entry widget and the file list.
if {![catch {package require Tk}]
 && ![catch {package require ctrlutils::cufilter}]
 && ![catch {package require tkutils::tkufilelist}]} {
    testConstraint haveTk 1
} else {
    testConstraint haveTk 0
}
catch {package require tclutils::tuprovider}

# a scratch directory with a known mix of files
set ::fdir [makeDirectory cufilt]
foreach n {bericht.txt bericht.pdf notiz.txt daten.csv} {
    set fh [open [file join $::fdir $n] w] ; puts $fh x ; close $fh
}
proc rows {lst} { llength [$lst.tbl childkeys root] }

test cufilter-1.1 {bare text filters as a substring} -constraints haveTk -setup {
    set prov [::tclutils::tuprovider open local]
    ::tkutils::tkufilelist::widget .l1 -provider $prov -dir $::fdir
    ::ctrlutils::cufilter::widget .f1 .l1
} -body {
    set ::ctrlutils::cufilter::state(.f1,text) "bericht"
    ::ctrlutils::cufilter::_apply .f1
    rows .l1
} -cleanup {
    destroy .l1 .f1
} -result 2

test cufilter-1.2 {a glob is honored as-is} -constraints haveTk -setup {
    set prov [::tclutils::tuprovider open local]
    ::tkutils::tkufilelist::widget .l2 -provider $prov -dir $::fdir
    ::ctrlutils::cufilter::widget .f2 .l2
} -body {
    set ::ctrlutils::cufilter::state(.f2,text) "*.txt"
    ::ctrlutils::cufilter::_apply .f2
    rows .l2
} -cleanup {
    destroy .l2 .f2
} -result 2

test cufilter-1.3 {clear shows all files again} -constraints haveTk -setup {
    set prov [::tclutils::tuprovider open local]
    ::tkutils::tkufilelist::widget .l3 -provider $prov -dir $::fdir
    ::ctrlutils::cufilter::widget .f3 .l3
} -body {
    set ::ctrlutils::cufilter::state(.f3,text) "bericht"
    ::ctrlutils::cufilter::_apply .f3
    ::ctrlutils::cufilter::clear .f3
    rows .l3
} -cleanup {
    destroy .l3 .f3
} -result 4

test cufilter-1.4 {setFilter on the list is case-insensitive} -constraints haveTk -setup {
    set prov [::tclutils::tuprovider open local]
    ::tkutils::tkufilelist::widget .l4 -provider $prov -dir $::fdir
} -body {
    ::tkutils::tkufilelist::setFilter .l4 *BERICHT*
    rows .l4
} -cleanup {
    destroy .l4
} -result 2

test cufilter-9.1 {label and clear button go through msgcat} -constraints haveTk -setup {
    namespace eval ::ctrlutils {
        ::msgcat::mcset [::msgcat::mclocale] "Filter:" "Suche:"
        ::msgcat::mcset [::msgcat::mclocale] "x" "×"
    }
} -body {
    ::ctrlutils::cufilter::widget .mcf .gibtsnicht
    list [.mcf.l cget -text] [.mcf.x cget -text]
} -cleanup {
    destroy .mcf
    namespace eval ::ctrlutils {
        ::msgcat::mcset [::msgcat::mclocale] "Filter:" "Filter:"
        ::msgcat::mcset [::msgcat::mclocale] "x" "x"
    }
} -result [list Suche: \u00d7]

test cufilter-10.1 {a filter that cannot be applied marks the entry and keeps the error (0.2)} -constraints haveTk -setup {
    ::ctrlutils::cufilter::widget .ef .keineListe
    set ::efErr 0
    bind .ef <<CufilterError>> { incr ::efErr }
} -body {
    set ::ctrlutils::cufilter::state(.ef,text) "bericht"
    ::ctrlutils::cufilter::_apply .ef
    update
    list [expr {[::ctrlutils::cufilter::lastError .ef] ne ""}] [.ef.e instate invalid] $::efErr
} -cleanup {
    destroy .ef
} -result {1 1 1}

test cufilter-10.2 {a working filter clears the error} -constraints haveTk -setup {
    set prov [::tclutils::tuprovider open local]
    ::tkutils::tkufilelist::widget .l10 -provider $prov -dir $::fdir
    ::ctrlutils::cufilter::widget .f10 .l10
    set ::ctrlutils::cufilter::state(.f10,error) alt
    .f10.e state invalid
} -body {
    set ::ctrlutils::cufilter::state(.f10,text) "bericht"
    ::ctrlutils::cufilter::_apply .f10
    list [::ctrlutils::cufilter::lastError .f10] [.f10.e instate invalid]
} -cleanup {
    destroy .l10 .f10
} -result {{} 0}

cleanupTests
